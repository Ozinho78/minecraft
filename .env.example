# ============================================================================
# Minecraft Server - Environment Configuration
# ============================================================================
# Copy this file to .env and adjust the values to your needs
# cp .env.example .env
# ============================================================================

# ============================================================================
# EULA ACCEPTANCE (REQUIRED)
# ============================================================================
# You MUST accept the Minecraft EULA to run the server
# Set to 'true' to accept: https://www.minecraft.net/en-us/eula
EULA=false

# ============================================================================
# SERVER VERSION
# ============================================================================
# Minecraft server version
# Note: Changing this requires rebuilding the container
MINECRAFT_VERSION=1.21.11

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================
# Internal Minecraft server port (inside container)
MINECRAFT_PORT=25565

# External port exposed on host machine
# Players connect to: <your-ip>:EXTERNAL_PORT
EXTERNAL_PORT=8888

# ============================================================================
# SERVER IDENTITY
# ============================================================================
# Server name shown in the server list (MOTD - Message of the Day)
SERVER_NAME=My Minecraft Server

# Maximum number of players allowed on the server
MAX_PLAYERS=20

# ============================================================================
# MEMORY SETTINGS
# ============================================================================
# JVM Memory allocation (Xms = minimum, Xmx = maximum)
# Format: <number>M (Megabytes) or <number>G (Gigabytes)
# 
# Recommended settings based on player count:
#   1-5 players:   MEMORY_MIN=1024M   MEMORY_MAX=2048M
#   5-10 players:  MEMORY_MIN=2048M   MEMORY_MAX=4096M
#   10-20 players: MEMORY_MIN=3072M   MEMORY_MAX=6144M
#   20+ players:   MEMORY_MIN=4096M   MEMORY_MAX=8192M

MEMORY_MIN=1024M
MEMORY_MAX=2048M

# ============================================================================
# DOCKER RESOURCE LIMITS
# ============================================================================
# CPU and memory limits for the container
# These should be higher than MEMORY_MAX to allow for JVM overhead

CPU_LIMIT=2
CPU_RESERVATION=1
MEMORY_LIMIT=3G
MEMORY_RESERVATION=2G

# ============================================================================
# GAMEPLAY SETTINGS
# ============================================================================

# Game mode: survival, creative, adventure, spectator
GAMEMODE=survival

# Difficulty: peaceful, easy, normal, hard
DIFFICULTY=normal

# Enable/disable Player vs Player combat
PVP=true

# ============================================================================
# WORLD SETTINGS
# ============================================================================

# Radius of spawn protection (0 to disable)
# Players without OP status cannot place/break blocks within this radius
SPAWN_PROTECTION=16

# View distance in chunks (2-32)
# Higher values increase server load but improve player experience
# Recommended: 8-12 for most servers
VIEW_DISTANCE=10

# ============================================================================
# SERVER MODE
# ============================================================================

# Online mode (authentication)
# true:  Requires valid Minecraft account (recommended for public servers)
# false: Allows cracked clients (use only for private/offline servers)
ONLINE_MODE=true

# ============================================================================
# ADVANCED SETTINGS (Optional)
# ============================================================================

# Custom Java JVM options (advanced users only)
# Leave empty for default optimized settings
# Example: JAVA_OPTS=-Dlog4j2.formatMsgNoLookups=true
JAVA_OPTS=

# Timezone for container
# Default: Europe/Berlin
TZ=Europe/Berlin

# ============================================================================
# BACKUP SETTINGS (Optional)
# ============================================================================
# These are used if you implement backup scripts

# Enable automatic backups
# BACKUP_ENABLED=true

# Backup interval in hours
# BACKUP_INTERVAL=6

# Number of backups to retain
# BACKUP_RETENTION=7

# ============================================================================
# DEVELOPMENT/DEBUG OPTIONS
# ============================================================================
# Set to 'true' for verbose logging (not recommended for production)
# DEBUG=false
