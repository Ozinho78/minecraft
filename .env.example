# Minecraft Server Environment Configuration
# Copy this file to '.env' and adjust values as needed
# NOTE: Never commit the .env file to version control!

# ===========================
# EULA ACCEPTANCE (REQUIRED)
# ===========================
# You MUST set this to 'true' to accept the Minecraft EULA
# https://www.minecraft.net/en-us/eula
EULA=false

# ===========================
# SERVER CONFIGURATION
# ===========================
MINECRAFT_VERSION=1.21.1
MINECRAFT_PORT=25565
SERVER_NAME=My Minecraft Server

# ===========================
# MEMORY SETTINGS
# ===========================
# Minimum and maximum memory allocation for the JVM
MEMORY_MIN=1024M
MEMORY_MAX=2048M

# ===========================
# GAME SETTINGS
# ===========================
# Gamemode: survival, creative, adventure, spectator
GAMEMODE=survival

# Difficulty: peaceful, easy, normal, hard
DIFFICULTY=normal

# Maximum number of players
MAX_PLAYERS=20

# Online mode (authentication with Mojang servers)
ONLINE_MODE=true

# Enable PvP
PVP=true

# Spawn protection radius in blocks
SPAWN_PROTECTION=16

# View distance in chunks (2-32)
VIEW_DISTANCE=10
